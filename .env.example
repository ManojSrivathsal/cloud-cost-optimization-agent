# Cloud Cost Optimization Agent Environment Variables

# Backend API configuration (FastAPI server owned by Laksh)
BACKEND_API_URL=http://localhost:8000

# Agent staleness threshold in seconds (default: 300 = 5 minutes)
AGENT_STALENESS_THRESHOLD_SECONDS=300

# Optional LLM API keys (Leave blank to use the built-in deterministic fallback engine)
# NEVER commit your actual API keys to Git!
GEMINI_API_KEY=
OPENAI_API_KEY=
